#!/usr/bin/env bash
# 假 wmake（L1 用）。绝不调真编译器；只记录被怎么调用，并按环境变量决定成败。
printf '%s\n' "$*" >> "${FAKE_WMAKE_LOG:-/dev/null}"
if [ -n "${FAKE_WMAKE_SLEEP:-}" ]; then
    sleep "${FAKE_WMAKE_SLEEP}"
fi
if [ "${FAKE_WMAKE_RC:-0}" -ne 0 ]; then
    printf '%s:12:5: error: expected initializer before %s\n' "${FAKE_ERR_FILE:-demo.C}" "'}'" >&2
    exit "${FAKE_WMAKE_RC}"
fi
# 造「退 0 但日志里有 error:」——V3 的第二个分支，rc 抓到它反而会漏
if [ -n "${FAKE_ERR_ALWAYS:-}" ]; then
    printf '%s:12:5: error: expected initializer before %s\n' "${FAKE_ERR_FILE:-demo.C}" "'}'" >&2
fi
: > "${FAKE_SO_OUT:?需要 FAKE_SO_OUT}"
printf 'making dependency list for source file demo.C\n'
exit 0
